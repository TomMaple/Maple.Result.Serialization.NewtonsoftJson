<Project>

  <!-- Reports the code style rules of .editorconfig (IDE*) in command-line builds, not only in the IDE. -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- NuGet lock files (packages.lock.json, committed) pin every direct and transitive package by version and hash.
       A local restore updates them; CI restores in locked mode and fails when they are out of date. -->
  <!-- Not for the library: the SDK adds Microsoft.NET.ILLink.Tasks implicitly for IsAotCompatible, in the version of the
       installed runtime, so its lock file would break on every SDK patch. Its other packages, Maple.Result and
       Newtonsoft.Json, have exact versions and no dependencies; the test project locks them too. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Maple.Result.Serialization.NewtonsoftJson'">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- CI fails on any warning and on a lock file that does not match the project files; local builds only report
       warnings. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

</Project>
